# Extensionless executables: ignore every file without a dot in its name
# (the "*" rule also matches directories, so re-include them first)
*
!*/
!*.*

# Compiled C executables
*.out
*.o
*.a
*.so
*.dylib

# Executables without extensions (macOS/Linux)
main
a.out

# Debug files
*.dSYM/

# macOS
.DS_Store
